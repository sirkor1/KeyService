{
	http_port 80
	https_port 8443
	admin off
	email $ACME_EMAIL
}

http://$DOMAIN {
	bind 0.0.0.0 [::]
	redir https://{host}{uri} permanent
}

https://$DOMAIN:8443 {
	bind 127.0.0.1
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	root * /srv/site
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
