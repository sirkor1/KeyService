{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft": "Warning",
        "System": "Warning",
        "MongoDB": "Warning"
      }
    }
  },

  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },

  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "amnezia_vpn",
    "UsersCollection": "users",
    "ClientsCollection": "clients",
    "ServerConfigCollection": "server_config",
    "PassCodesCollection": "passcodes"
  },

  "Security": {
    "//": "32 байта в base64 через SECURITY__DATAPROTECTIONKEY. SSH бот не открывает, но MongoSchemaGate ждёт полный список миграций, а среди них M003_ServersV2 с ISecretProtector в конструкторе — без ключа контейнер не соберётся.",
    "DataProtectionKey": "",
    "ActiveKeyId": "default",
    "Keys": []
  },

  "TelegramBot": {
    "//": "Токен задавайте только через TelegramBot__Token. Пусто — бот не запускается.",
    "Token": ""
  },

  "Notifications": {
    "Enabled": true,
    "PollIntervalMilliseconds": 500,
    "StartupDelaySeconds": 5,
    "BatchSize": 10,
    "MessagesPerSecond": 20,
    "MaxAttempts": 5,
    "LeaseTtlSeconds": 60
  },

  "EventBus": {
    "//": "Шина доменных событий: бот только читает notify.key_issued, публикует его worker.",
    "Enabled": true,
    "PollIntervalSeconds": 1,
    "StartupDelaySeconds": 5,
    "BatchSize": 10,
    "LeaseTtlSeconds": 60,
    "HeartbeatSeconds": 20,
    "PartitionBusyDelaySeconds": 2,
    "ReaperIntervalSeconds": 30
  }
}
