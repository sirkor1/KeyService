# /etc/nginx/sites-available/amnezia-key
#
# Temporary IP-only HTTPS configuration. Replace PUBLIC_IPV4 with the VPS
# public IPv4 address. The corresponding Compose overlay binds web and API to
# loopback, so Nginx is the only public listener.
#
# The fixed certificate lineage is deliberate: Certbot must be issued with
# `--cert-name amnezia-ip`, therefore these paths never depend on the IP text.

upstream amnezia_panel {
    server 127.0.0.1:8081;
    keepalive 16;
}

upstream amnezia_api {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    server_name PUBLIC_IPV4;

    # Keep the challenge path available for short-lived IP certificate renewal.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # Redirect after TLS is available; Nginx never proxies the panel over HTTP.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name PUBLIC_IPV4;

    ssl_certificate     /etc/letsencrypt/live/amnezia-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/amnezia-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # The panel accepts an SSH private key; align with the inner web Nginx.
    client_max_body_size 64k;
    client_body_timeout 30s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    location / {
        proxy_pass http://amnezia_panel;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 600s;
    }

    # Installation progress is an SSE stream, so it must not be buffered.
    location ^~ /api/jobs/ {
        proxy_pass http://amnezia_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 600s;
    }

    location ^~ /api/ {
        proxy_pass http://amnezia_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
