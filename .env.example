# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

# ── Обязательные ─────────────────────────────────────────────────────────────

# Подпись JWT. Минимум 32 байта, иначе приложение не стартует.
#   openssl rand -base64 48
JWT_SECRET=

# Шифрование секретов в MongoDB (SSH-пароли и приватные ключи). Ровно 32 байта в base64.
# ВАЖНО: потеря этого ключа делает все сохранённые секреты нечитаемыми безвозвратно.
#   openssl rand -base64 32
DATA_PROTECTION_KEY=

# Владелец панели, создаётся при первом запуске.
# Если владельца в базе нет и пароль не задан — приложение откажется стартовать.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Необязательные ───────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=

# ── MongoDB authentication (explicit production opt-in) ─────────────────────

# Keep blank for the existing unauthenticated local development flow.
# For authentication use an encoded application URI, including authSource:
# mongodb://<app-user>:<percent-encoded-password>@mongo:27017/amnezia_vpn?authSource=amnezia_vpn
# See DEPLOYMENT.md before enabling docker-compose.mongo-auth.yml.
MONGODB_CONNECTION_STRING=

# Required only once for docker-compose.mongo-auth.fresh.yml and only with a
# known-empty MongoDB volume. Do not retain root credentials in the steady-state
# compose invocation after the bootstrap has completed.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
MONGO_DATABASE_NAME=amnezia_vpn

# ── Логи (Seq) ───────────────────────────────────────────────────────────────

# Хэш пароля администратора Seq. Пустое значение оставляет первый вход
# без пароля — интерфейс слушает только на 127.0.0.1, но задать всё равно стоит.
#   docker run --rm datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=

# Ключ приёма логов. Создаётся в самом Seq (Settings → API Keys).
# Пустое значение допустимо: внутри сети compose порт 5341 наружу не выходит.
SEQ_API_KEY=
