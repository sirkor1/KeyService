# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

# ── Обязательные ─────────────────────────────────────────────────────────────

# Подпись JWT. Минимум 32 байта, иначе приложение не стартует.
#   openssl rand -base64 48
JWT_SECRET=

# Шифрование секретов в MongoDB (SSH-пароли и приватные ключи). Ровно 32 байта в base64.
# ВАЖНО: потеря этого ключа делает все сохранённые секреты нечитаемыми безвозвратно.
#   openssl rand -base64 32
DATA_PROTECTION_KEY=

# Владелец панели, создаётся при первом запуске.
# Если владельца в базе нет и пароль не задан — приложение откажется стартовать.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Необязательные ───────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=

# Почта для сертификатов Let's Encrypt на узлах xcore (подписки Happ).
# Без неё установка xcore отклоняется; остальные протоколы её не требуют.
XCORE_ACME_EMAIL=
# Адрес, куда вход проксирует /sub/ (публичный адрес API панели), например https://sub-origin.example.com.
# Без него входу нельзя задать домен подписки; остальное работает и так.
XCORE_SUBSCRIPTION_UPSTREAM=

# Подписки Happ. Публичный адрес, с которого клиенты забирают подписку, например
# https://sub.example.com. Без него подписку создать можно, а показать ссылку — нет (если ни у одного входа
# нет домена подписки: тогда ссылка строится на него и этот адрес не нужен).
SUBSCRIPTION_PUBLIC_BASE_URL=
# Название профиля в приложении (до 25 символов), ссылка на поддержку (необязательна)
# и как часто приложение перезапрашивает подписку, в часах.
SUBSCRIPTION_PROFILE_TITLE=VPN
SUBSCRIPTION_SUPPORT_URL=
SUBSCRIPTION_UPDATE_INTERVAL_HOURS=12

# Профиль маршрутизации Happ: российские сайты напрямую с устройства пользователя.
# По умолчанию выключен.
SUBSCRIPTION_HAPP_ROUTING_ENABLED=false
SUBSCRIPTION_HAPP_ROUTING_NAME=RU direct
# Provider ID с happ-proxy.com: включает запасной адрес подписки (fallback-url). По умолчанию пусто.
# С ним Happ раз в день отправляет на check.happ-proxy.com идентификатор устройства (HWID),
# хеш домена и версию ОС.
SUBSCRIPTION_HAPP_PROVIDER_ID=

# Списки runetfreedom на входах в РФ: «заблокировано в РФ» — через выход,
# «доступно только из РФ» — напрямую. Обновление не чаще раза в N дней.
XCORE_RF_LISTS_ENABLED=true
XCORE_RF_LISTS_REPO=runetfreedom/russia-v2ray-rules-dat
XCORE_RF_LISTS_MIN_AGE_DAYS=7
# Пауза после неудачного выпуска сертификата домена подписки, в минутах:
# Let's Encrypt блокирует выпуск после серии неудачных проверок.
XCORE_CADDY_RETRY_MINUTES=60

# ── MongoDB authentication (explicit production opt-in) ─────────────────────

# Keep blank for the existing unauthenticated local development flow.
# For authentication use an encoded application URI, including authSource:
# mongodb://<app-user>:<percent-encoded-password>@mongo:27017/amnezia_vpn?authSource=amnezia_vpn
# See DEPLOYMENT.md before enabling docker-compose.mongo-auth.yml.
MONGODB_CONNECTION_STRING=

# Required only once for docker-compose.mongo-auth.fresh.yml and only with a
# known-empty MongoDB volume. Do not retain root credentials in the steady-state
# compose invocation after the bootstrap has completed.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
MONGO_DATABASE_NAME=amnezia_vpn

# ── Логи (Seq) ───────────────────────────────────────────────────────────────

# Хэш пароля администратора Seq. Пустое значение оставляет первый вход
# без пароля — интерфейс слушает только на 127.0.0.1, но задать всё равно стоит.
#   docker run --rm datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=

# Ключ приёма логов. Создаётся в самом Seq (Settings → API Keys).
# Пустое значение допустимо: внутри сети compose порт 5341 наружу не выходит.
SEQ_API_KEY=
